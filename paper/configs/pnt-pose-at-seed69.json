{
  "model": "PntPoseAT",
  "data_root": "data/mmwave_densepose",
  "num_points": 300,
  "input_dim": 5,
  "num_joints": 19,
  "seq_len": 5,
  "seed": 69,
  "batch_size": 128,
  "epochs": 50,
  "learning_rate": 0.001,
  "weight_decay": 0.00001,
  "optimizer": "adam",
  "ablation": "full",
  "checkpoint": "paper/experiments/pnt-pose-at-seed69/checkpoints/best.ckpt",
  "scheduler_name": "step",
  "scheduler_eta_min": 0.000001,
  "scheduler_step_size": 30,
  "scheduler_gamma": 0.1,
  "split_strategy": "sequence_chunk",
  "partition": [
    0.8,
    0.1,
    0.1
  ],
  "split_chunk_size": 200,
  "max_timestamp_gap_ms": 300,
  "min_valid_points": 50
}
